# Local secrets — never commit
.env

# Python
__pycache__/
*.py[cod]
*.pyo

# Local SQLite database (machine-specific inventory & state)
techstores.db
techstores.db-journal
techstores.db-wal
techstores.db-shm

# Product lookup cache
data/product-web-cache.json

# OS / editor
.DS_Store
Thumbs.db
*.swp

# Windows launcher shortcuts — machine-specific binaries (target path + icon).
# Regenerate with scripts/create-launcher-shortcuts.ps1 (or .bat).
*.lnk

# Runtime logs
mode_switch.log
**/mode_switch.log
