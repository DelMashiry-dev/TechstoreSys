# TECHSTORESys — optional AI features (set on the machine running server.py)
# Copy to .env and load before starting the server, or set in Windows Environment Variables.

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Without OPENAI_API_KEY:
# - Spec document photo parse: unavailable (paste text still works with heuristics)
# - Product enrich: heuristic web extract only
# - Stores assistant: GL, stock, requisitions, loans, modules, ICT trends (rule-based without key; full NL with key)
# - Requisition draft: template text only

# --- Supabase cloud backup (optional) ---
# Local SQLite remains the live database. When configured, each save is copied
# to Supabase as a JSON snapshot (debounced ~15s). Use Database → Restore from
# Supabase in the app to pull the newest cloud copy onto another machine.
#
# 1. Create a project at https://supabase.com
# 2. Run scripts/supabase-setup.sql in Supabase → SQL Editor
# 3. Settings → API: copy Project URL and service_role key (secret — server only)
#
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_BACKUP_ENABLED=1
# TECHSTORES_MACHINE_ID=DESKTOP-01
