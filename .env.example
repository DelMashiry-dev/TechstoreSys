# TECHSTORESys — optional AI features (set on the machine running server.py)
# Copy to .env and load before starting the server, or set in Windows Environment Variables.

OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_VISION_MODEL=gpt-4o-mini

# Without OPENAI_API_KEY:
# - Spec document photo parse: unavailable (paste text still works with heuristics)
# - Product enrich: heuristic web extract only
# - Stores assistant: GL, stock, requisitions, loans, modules, ICT trends (rule-based without key; full NL with key)
# - Requisition draft: template text only
